        "source": "/auth/google/callback",
        "destination": "/auth/callback",
        "regex": "^/auth/google/callback(?:/)?$"
      },
      {
        "source": "/callback",
        "destination": "/auth/callback",
        "regex": "^/callback(?:/)?$"
      }
    ],
    "fallback": []
  },
  "dynamicRoutes": [
