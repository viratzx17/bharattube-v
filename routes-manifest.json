      "page": "/channel/[id]",
      "regex": "^/channel/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/channel/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
